@page
@model PetShop.Pages.Servicos.IndexModel

@{
    ViewData["Title"] = "Gestão de Serviços";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">✂️ Gestão de Serviços</h1>
        <p class="text-muted mb-0">Serviços oferecidos pela Peludos & Companhia</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <strong>+ Novo Serviço</strong>
    </a>
</div>

<!-- Formulário de filtro -->
<div class="card mb-4 border-0">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-10">
                <label class="form-label">🔍 Pesquisar por nome ou descrição:</label>
                <input type="text" 
                       name="FiltroAtual" 
                       value="@Model.FiltroAtual" 
                       class="form-control" 
                       placeholder="Digite o nome ou descrição do serviço..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    Pesquisar
                </button>
            </div>
            @if (!string.IsNullOrEmpty(Model.FiltroAtual))
            {
                <div class="col-12">
                    <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
                        Limpar Filtro
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Grid de serviços em cards -->
@if (Model.Servicos.Any())
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
        @foreach (var servico in Model.Servicos)
        {
            <div class="col">
                <div class="card h-100 border-0">
                    <div class="card-header text-white">
                        <h5 class="card-title mb-0">@servico.NomeServico</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text text-muted small mb-3">
                            @(servico.Descricao ?? "Sem descrição")
                        </p>
                        <hr class="my-3" />
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">💰 Preço:</span>
                            <strong class="text-success fs-5">@servico.Preco.ToString("C")</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">⏱️ Duração:</span>
                            <span class="badge bg-info">@servico.DuracaoMinutos min</span>
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="btn-group w-100" role="group">
                            <a asp-page="./Details" asp-route-id="@servico.ServicoID" 
                               class="btn btn-info btn-sm" title="Detalhes">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-page="./Edit" asp-route-id="@servico.ServicoID" 
                               class="btn btn-dark btn-sm" title="Editar">
                                <i class="fas fa-pencil-alt"></i>
                            </a>
                            <a asp-page="./Delete" asp-route-id="@servico.ServicoID" 
                               class="btn btn-danger btn-sm" title="Eliminar">
                                <i class="fas fa-trash-alt"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Controles de paginação -->
    @if (Model.Servicos.TotalPaginas > 1)
    {
        <nav aria-label="Paginação">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Servicos.HaPaginasAntes ? "" : "disabled")">
                    <a class="page-link" 
                       asp-page="./Index" 
                       asp-route-indexPagina="@(Model.Servicos.PaginaIndex - 1)"
                       asp-route-ordenacaoAtual="@Model.OrdenacaoAtual"
                       asp-route-filtroAtual="@Model.FiltroAtual">
                        ← Anterior
                    </a>
                </li>
                
                <li class="page-item active">
                    <span class="page-link">
                        Página @Model.Servicos.PaginaIndex de @Model.Servicos.TotalPaginas
                    </span>
                </li>
                
                <li class="page-item @(Model.Servicos.HaPaginasDepois ? "" : "disabled")">
                    <a class="page-link" 
                       asp-page="./Index" 
                       asp-route-indexPagina="@(Model.Servicos.PaginaIndex + 1)"
                       asp-route-ordenacaoAtual="@Model.OrdenacaoAtual"
                       asp-route-filtroAtual="@Model.FiltroAtual">
                        Próximo →
                    </a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="card border-0">
        <div class="card-body text-center py-5">
            <p class="mb-2" style="font-size: 3rem;">✂️</p>
            <h5>Nenhum serviço encontrado</h5>
            <p class="text-muted">
                @if (!string.IsNullOrEmpty(Model.FiltroAtual))
                {
                    <span>Tente ajustar os filtros de pesquisa ou </span>
                    <a asp-page="./Index" class="alert-link">limpar filtro</a>
                }
                else
                {
                    <span>Comece adicionando o primeiro serviço ao sistema.</span>
                }
            </p>
            @if (string.IsNullOrEmpty(Model.FiltroAtual))
            {
                <a asp-page="./Create" class="btn btn-primary mt-3">Adicionar Primeiro Serviço</a>
            }
        </div>
    </div>
}
