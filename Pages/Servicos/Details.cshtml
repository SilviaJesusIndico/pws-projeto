@page
@model PetShop.Pages.Servicos.DetailsModel

@{
    ViewData["Title"] = "Detalhes do Serviço";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <h1>🛁 Detalhes do Serviço</h1>
        <hr />
        
        <!-- Card principal com informações do serviço -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@Model.Servico.NomeServico</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="text-muted">Descrição</h5>
                        <p>@(Model.Servico.Descricao ?? "Sem descrição disponível")</p>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-3 bg-light rounded">
                            <h6 class="text-muted">Preço</h6>
                            <h2 class="text-success mb-0">@Model.Servico.Preco.ToString("C")</h2>
                        </div>
                        <div class="text-center p-3 bg-light rounded mt-3">
                            <h6 class="text-muted">Duração</h6>
                            <h3 class="text-primary mb-0">@Model.Servico.DuracaoMinutos <small>min</small></h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Card com estatísticas -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">📊 Estatísticas de Uso</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4">
                        <div class="p-3">
                            <h2 class="text-primary">@Model.TotalAgendamentos</h2>
                            <p class="text-muted mb-0">Total de Agendamentos</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3">
                            <h2 class="text-success">@(Model.ReceitaTotal?.ToString("C") ?? "€0,00")</h2>
                            <p class="text-muted mb-0">Receita Total Gerada</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3">
                            <h2 class="text-info">
                                @if (Model.TotalAgendamentos > 0 && Model.ReceitaTotal.HasValue)
                                {
                                    @((Model.ReceitaTotal.Value / Model.TotalAgendamentos).ToString("C"))
                                }
                                else
                                {
                                    @:€0,00
                                }
                            </h2>
                            <p class="text-muted mb-0">Valor Médio por Agendamento</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Card com informações adicionais -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">ℹ️ Informações Adicionais</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">ID do Serviço</dt>
                    <dd class="col-sm-9">@Model.Servico.ServicoID</dd>
                    
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-success">Ativo</span>
                    </dd>
                    
                    <dt class="col-sm-3">Tempo Médio</dt>
                    <dd class="col-sm-9">
                        @{
                            var horas = Model.Servico.DuracaoMinutos / 60;
                            var minutos = Model.Servico.DuracaoMinutos % 60;
                        }
                        @if (horas > 0)
                        {
                            @:@horas h @minutos min
                        }
                        else
                        {
                            @:@minutos minutos
                        }
                    </dd>
                    
                    <dt class="col-sm-3">Preço por Hora</dt>
                    <dd class="col-sm-9">
                        @{
                            var precoPorHora = (Model.Servico.Preco / Model.Servico.DuracaoMinutos) * 60;
                        }
                        @precoPorHora.ToString("C")
                    </dd>
                </dl>
            </div>
        </div>
        
        <!-- Botões de ação -->
        <div class="d-flex justify-content-between mb-4">
            <a asp-page="./Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Voltar à Lista
            </a>
            <div>
                <a asp-page="./Edit" asp-route-id="@Model.Servico.ServicoID" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <a asp-page="./Delete" asp-route-id="@Model.Servico.ServicoID" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Eliminar
                </a>
            </div>
        </div>
    </div>
</div>
