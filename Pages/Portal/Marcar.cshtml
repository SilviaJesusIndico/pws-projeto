@* ============================================================================
    PORTAL/MARCAR.CSHTML - Página de Marcação de Serviços
    ============================================================================
    
    Esta é a página principal de marcação de serviços para os clientes.
    Permite que utilizadores públicos (não autenticados) agendem serviços.
    
    Funcionalidades:
    - Formulário completo para recolha de dados do cliente
    - Registo do animal de estimação
    - Seleção de serviço e data/hora preferida
    - Validação de campos obrigatórios
    - Mensagem de sucesso após marcação
    
    Estrutura do formulário:
    1. Dados do Cliente (nome, email, telefone)
    2. Dados do Pet (nome, espécie, raça, idade)
    3. Serviço e Data (serviço pretendido, data, observações)
    
    Layout: _Layout.cshtml (portal público)
    Model: MarcarModel (cria cliente, animal e agendamento)
============================================================================ *@

@page
@model PetShop.Pages.Portal.MarcarModel
@{
    ViewData["Title"] = "Marcar Serviço";
}

<div class="container py-5">
    <div class="row justify-content-center">
        @* Limita a largura do formulário para melhor legibilidade *@
        <div class="col-lg-8">
            @* ===== CARD PRINCIPAL DO FORMULÁRIO ===== *@
            <div class="card booking-card">
                @* ===== CABEÇALHO DO CARD ===== *@
                <div class="card-header text-center">
                    <h2>📅 Marcar Serviço</h2>
                    <p class="mb-0">Preencha os dados para agendar um serviço para o seu pet</p>
                </div>

                <div class="card-body p-4">
                    @* ===== MENSAGEM DE SUCESSO =====
                       Mostrada após uma marcação bem-sucedida *@
                    @if (Model.Sucesso)
                    {
                        <div class="alert alert-success text-center">
                            <h4>✅ Marcação Realizada com Sucesso!</h4>
                            <p>O seu pedido de agendamento foi recebido. Entraremos em contacto para confirmar.</p>
                            <hr />
                            <p class="mb-0">
                                <a href="/Portal" class="btn btn-primary">Voltar ao Portal</a>
                            </p>
                        </div>
                    }
                    else
                    {
                        @* ===== FORMULÁRIO DE MARCAÇÃO ===== *@
                        <form method="post">
                            @* Sumário de erros de validação do modelo *@
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            @* ===== SECÇÃO 1: DADOS DO CLIENTE =====
                               Recolhe informações de contacto do proprietário *@
                            <fieldset class="mb-4">
                                <legend class="fieldset-legend">👤 Os Seus Dados</legend>
                                <div class="row">
                                    @* Campo: Nome Completo (obrigatório) *@
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.NomeCliente" class="form-label">Nome Completo *</label>
                                        <input asp-for="Input.NomeCliente" class="form-control" placeholder="O seu nome" />
                                        <span asp-validation-for="Input.NomeCliente" class="text-danger"></span>
                                    </div>
                                    @* Campo: Email (obrigatório, validado como email) *@
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.Email" class="form-label">Email *</label>
                                        <input asp-for="Input.Email" class="form-control" type="email" placeholder="seu@email.com" />
                                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="row">
                                    @* Campo: Telefone (obrigatório) *@
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.Telefone" class="form-label">Telefone *</label>
                                        <input asp-for="Input.Telefone" class="form-control" placeholder="912 345 678" />
                                        <span asp-validation-for="Input.Telefone" class="text-danger"></span>
                                    </div>
                                </div>
                            </fieldset>

                            @* ===== SECÇÃO 2: DADOS DO ANIMAL =====
                               Recolhe informações sobre o pet a ser tratado *@
                            <fieldset class="mb-4">
                                <legend class="fieldset-legend">🐾 Dados do Pet</legend>
                                <div class="row">
                                    @* Campo: Nome do Animal (obrigatório) *@
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.NomeAnimal" class="form-label">Nome do Animal *</label>
                                        <input asp-for="Input.NomeAnimal" class="form-control" placeholder="Nome do seu pet" />
                                        <span asp-validation-for="Input.NomeAnimal" class="text-danger"></span>
                                    </div>
                                    @* Campo: Espécie (obrigatório, dropdown com opções) *@
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.Especie" class="form-label">Espécie *</label>
                                        <select asp-for="Input.Especie" class="form-select">
                                            <option value="">Selecione...</option>
                                            <option value="Cão">🐕 Cão</option>
                                            <option value="Gato">🐱 Gato</option>
                                            <option value="Ave">🐦 Ave</option>
                                            <option value="Roedor">🐹 Roedor</option>
                                            <option value="Réptil">🦎 Réptil</option>
                                            <option value="Outro">🐾 Outro</option>
                                        </select>
                                        <span asp-validation-for="Input.Especie" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="row">
                                    @* Campo: Raça (opcional) *@
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.Raca" class="form-label">Raça</label>
                                        <input asp-for="Input.Raca" class="form-control" placeholder="Raça do animal (opcional)" />
                                    </div>
                                    @* Campo: Idade (opcional, numérico) *@
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.Idade" class="form-label">Idade (anos)</label>
                                        <input asp-for="Input.Idade" class="form-control" type="number" min="0" placeholder="Idade aproximada" />
                                    </div>
                                </div>
                            </fieldset>

                            @* ===== SECÇÃO 3: SERVIÇO E DATA =====
                               Seleção do serviço e agendamento *@
                            <fieldset class="mb-4">
                                <legend class="fieldset-legend">📋 Serviço e Data</legend>
                                <div class="row">
                                    @* Campo: Serviço Pretendido (obrigatório, dropdown dinâmico) *@
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.ServicoId" class="form-label">Serviço Pretendido *</label>
                                        @* SelectList carregada do código-behind com serviços da BD *@
                                        <select asp-for="Input.ServicoId" class="form-select" asp-items="Model.ServicosDisponiveis">
                                            <option value="">Selecione um serviço...</option>
                                        </select>
                                        <span asp-validation-for="Input.ServicoId" class="text-danger"></span>
                                    </div>
                                    @* Campo: Data e Hora Preferida (obrigatório) *@
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Input.DataPreferida" class="form-label">Data Preferida *</label>
                                        <input asp-for="Input.DataPreferida" class="form-control" type="datetime-local" />
                                        <span asp-validation-for="Input.DataPreferida" class="text-danger"></span>
                                    </div>
                                </div>
                                @* Campo: Observações (opcional, texto livre) *@
                                <div class="mb-3">
                                    <label asp-for="Input.Observacoes" class="form-label">Observações</label>
                                    <textarea asp-for="Input.Observacoes" class="form-control" rows="3" 
                                        placeholder="Alguma informação adicional que devamos saber?"></textarea>
                                </div>
                            </fieldset>

                            @* ===== BOTÕES DE AÇÃO ===== *@
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                @* Botão Cancelar: Volta ao portal *@
                                <a href="/Portal" class="btn btn-secondary me-md-2">Cancelar</a>
                                @* Botão Submeter: Envia o formulário *@
                                <button type="submit" class="btn btn-primary btn-lg">
                                    ✅ Confirmar Marcação
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* ===== SCRIPTS DE VALIDAÇÃO =====
   Carrega scripts jQuery para validação do lado do cliente *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
