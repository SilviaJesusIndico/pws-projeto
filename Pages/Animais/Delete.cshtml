@page
@model PetShop.Pages.Animais.DeleteModel

@{
    ViewData["Title"] = "Eliminar Animal";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1 class="text-danger">🗑️ Eliminar Animal</h1>
        <hr />
        
        <!-- Aviso de confirmação -->
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">⚠️ Atenção!</h4>
            <p>Tem a certeza que deseja eliminar este animal?</p>
            <hr>
            <p class="mb-0">
                <strong>Nota:</strong> Todos os agendamentos associados a este animal também serão eliminados (cascade delete).
            </p>
        </div>
        
        <!-- Detalhes do animal -->
        <div class="card">
            <div class="card-header">
                <h5>Detalhes do Animal</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Nome</dt>
                    <dd class="col-sm-9">@Model.Animal.Nome</dd>
                    
                    <dt class="col-sm-3">Espécie</dt>
                    <dd class="col-sm-9">@Model.Animal.Especie</dd>
                    
                    <dt class="col-sm-3">Raça</dt>
                    <dd class="col-sm-9">@(Model.Animal.Raca ?? "Não especificada")</dd>
                    
                    <dt class="col-sm-3">Data Nascimento</dt>
                    <dd class="col-sm-9">@Model.Animal.DataNascimento.ToString("dd/MM/yyyy")</dd>
                    
                    <dt class="col-sm-3">Peso</dt>
                    <dd class="col-sm-9">@(Model.Animal.Peso.HasValue ? $"{Model.Animal.Peso:F1} kg" : "Não especificado")</dd>
                    
                    <dt class="col-sm-3">Proprietário</dt>
                    <dd class="col-sm-9">@(Model.Animal.Cliente?.NomeCompleto ?? "N/A")</dd>
                    
                    <dt class="col-sm-3">Email Proprietário</dt>
                    <dd class="col-sm-9">@(Model.Animal.Cliente?.Email ?? "N/A")</dd>
                    
                    @if (!string.IsNullOrEmpty(Model.Animal.ObservacoesMedicas))
                    {
                        <dt class="col-sm-3">Observações</dt>
                        <dd class="col-sm-9">@Model.Animal.ObservacoesMedicas</dd>
                    }
                </dl>
            </div>
        </div>
        
        <hr />
        
        <!-- Formulário de confirmação -->
        <form method="post">
            <input type="hidden" asp-for="Animal.AnimalID" />
            
            <div class="d-flex justify-content-between">
                <a asp-page="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Confirmar Eliminação
                </button>
            </div>
        </form>
    </div>
</div>
