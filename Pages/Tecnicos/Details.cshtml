@page
@model PetShop.Pages.Tecnicos.DetailsModel

@{
    ViewData["Title"] = "Detalhes do Técnico";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-md-10 offset-md-1">
        <h1>👨‍⚕️ Detalhes do Técnico</h1>
        <hr />
        
        <!-- Card com informações do técnico -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">@Model.Tecnico.NomeCompleto</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">
                        <a href="mailto:@Model.Tecnico.Email">@Model.Tecnico.Email</a>
                    </dd>
                    
                    <dt class="col-sm-3">Telefone</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrEmpty(Model.Tecnico.Telefone))
                        {
                            <a href="tel:@Model.Tecnico.Telefone">@Model.Tecnico.Telefone</a>
                        }
                        else
                        {
                            <span class="text-muted">Não especificado</span>
                        }
                    </dd>
                    
                    <dt class="col-sm-3">Especialização</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrEmpty(Model.Tecnico.Especializacao))
                        {
                            <span class="badge bg-info">@Model.Tecnico.Especializacao</span>
                        }
                        else
                        {
                            <span class="text-muted">Não especificada</span>
                        }
                    </dd>
                    
                    <dt class="col-sm-3">Data de Contratação</dt>
                    <dd class="col-sm-9">@Model.Tecnico.DataContratacao.ToString("dd/MM/yyyy")</dd>
                    
                    <dt class="col-sm-3">Tempo de Serviço</dt>
                    <dd class="col-sm-9">
                        @{
                            var tempoServico = DateTime.Now - Model.Tecnico.DataContratacao;
                            var anos = (int)(tempoServico.Days / 365.25);
                            var meses = (int)((tempoServico.Days % 365.25) / 30.44);
                        }
                        @if (anos > 0)
                        {
                            @:@anos ano@(anos != 1 ? "s" : "")
                        }
                        @if (meses > 0)
                        {
                            @:@meses mês@(meses != 1 ? "es" : "")
                        }
                    </dd>
                    
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-@(Model.Tecnico.Ativo ? "success" : "secondary") fs-6">
                            @(Model.Tecnico.Ativo ? "✓ Ativo" : "✗ Inativo")
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
        
        <!-- Card com estatísticas -->
        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">📊 Estatísticas de Desempenho</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4">
                        <div class="p-3">
                            <h2 class="text-primary">@Model.TotalAgendamentos</h2>
                            <p class="text-muted mb-0">Total de Agendamentos</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3">
                            <h2 class="text-success">@Model.AgendamentosConluidos</h2>
                            <p class="text-muted mb-0">Agendamentos Concluídos</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3">
                            <h2 class="text-info">
                                @if (Model.TotalAgendamentos > 0)
                                {
                                    @:@(((double)Model.AgendamentosConluidos / Model.TotalAgendamentos * 100).ToString("F0"))%
                                }
                                else
                                {
                                    @:0%
                                }
                            </h2>
                            <p class="text-muted mb-0">Taxa de Conclusão</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Card com histórico de agendamentos -->
        <div class="card mb-4">
            <div class="card-header bg-warning">
                <h5 class="mb-0">📅 Histórico de Agendamentos</h5>
            </div>
            <div class="card-body">
                @if (Model.Tecnico.Agendamentos != null && Model.Tecnico.Agendamentos.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Data/Hora</th>
                                    <th>Animal</th>
                                    <th>Cliente</th>
                                    <th>Serviço</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var agendamento in Model.Tecnico.Agendamentos.OrderByDescending(a => a.DataHora).Take(10))
                                {
                                    <tr>
                                        <td>@agendamento.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@(agendamento.Animal?.Nome ?? "N/A")</td>
                                        <td>@(agendamento.Animal?.Cliente?.NomeCompleto ?? "N/A")</td>
                                        <td>@(agendamento.Servico?.NomeServico ?? "N/A")</td>
                                        <td>
                                            <span class="badge bg-@(agendamento.Status switch {
                                                "Agendado" => "primary",
                                                "Confirmado" => "info",
                                                "Concluído" => "success",
                                                "Cancelado" => "danger",
                                                _ => "secondary"
                                            })">
                                                @agendamento.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.TotalAgendamentos > 10)
                    {
                        <p class="text-muted mb-0">
                            <small>Mostrando os últimos 10 de @Model.TotalAgendamentos agendamentos</small>
                        </p>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">Este técnico ainda não tem agendamentos registados.</p>
                }
            </div>
        </div>
        
        <!-- Botões de ação -->
        <div class="d-flex justify-content-between mb-4">
            <a asp-page="./Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Voltar à Lista
            </a>
            <div>
                <a asp-page="./Edit" asp-route-id="@Model.Tecnico.TecnicoID" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <a asp-page="./Delete" asp-route-id="@Model.Tecnico.TecnicoID" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Eliminar
                </a>
            </div>
        </div>
    </div>
</div>
