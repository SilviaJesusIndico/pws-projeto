@* =====================================================
    VIEW: Clientes/Edit.cshtml
    
    Responsabilidade:
    - Exibir formulário com dados do cliente
    - Permitir editar os dados
    - Enviar dados editados para o servidor
    ===================================================== *@

@page
@model PetShop.Pages.Clientes.EditModel

@{
    ViewData["Title"] = "Editar Cliente";
    Layout = "_AdminLayout";
}

<h1>Editar Cliente</h1>

<h4>Alterar Dados do Cliente</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Campo Oculto: ID (não editável) -->
            <input type="hidden" asp-for="Cliente.ClienteID" />

            <!-- Campo: Nome -->
            <div class="form-group mb-3">
                <label asp-for="Cliente.Nome" class="form-label"></label>
                <input asp-for="Cliente.Nome" class="form-control" />
                <span asp-validation-for="Cliente.Nome" class="text-danger"></span>
            </div>

            <!-- Campo: Apelido -->
            <div class="form-group mb-3">
                <label asp-for="Cliente.Apelido" class="form-label"></label>
                <input asp-for="Cliente.Apelido" class="form-control" />
                <span asp-validation-for="Cliente.Apelido" class="text-danger"></span>
            </div>

            <!-- Campo: Email -->
            <div class="form-group mb-3">
                <label asp-for="Cliente.Email" class="form-label"></label>
                <input asp-for="Cliente.Email" type="email" class="form-control" />
                <span asp-validation-for="Cliente.Email" class="text-danger"></span>
            </div>

            <!-- Campo: Telefone -->
            <div class="form-group mb-3">
                <label asp-for="Cliente.Telefone" class="form-label"></label>
                <input asp-for="Cliente.Telefone" type="tel" class="form-control" />
                <span asp-validation-for="Cliente.Telefone" class="text-danger"></span>
            </div>

            <!-- Botões de Ação -->
            <div class="form-group">
                <button type="submit" class="btn btn-warning">Guardar Alterações</button>
                <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
