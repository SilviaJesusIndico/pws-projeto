@* =====================================================
    VIEW: Clientes/Index.cshtml
    
    Responsabilidade:
    - Exibir lista de clientes com paginação, filtros e ordenação
    - Permitir criar novo cliente, editar, ver detalhes ou eliminar
    - Implementar navegação entre páginas
    
    Data Bindings:
    - Model.Clientes: Lista de clientes da página actual
    - Model.OrdenacaoNome: Para links de ordenação
    - Model.FiltroCorrente: Para filtro de busca
    ===================================================== *@

@page
@model PetShop.Pages.Clientes.IndexModel

@{
    ViewData["Title"] = "Clientes - Lista";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">👥 Clientes</h1>
    <a asp-page="Create" class="btn btn-primary">
        <strong>+ Criar Novo Cliente</strong>
    </a>
</div>

<!-- Formulário de Filtro -->
<div class="card mb-4 border-0">
    <div class="card-body">
        <form asp-page="./Index" method="get" class="row g-3">
            <div class="col-md-8">
                <label for="filtro" class="form-label">🔍 Filtrar por Nome/Email:</label>
                <input type="text" name="filtroTexto" value="@Model.FiltroCorrente" 
                       class="form-control" placeholder="Digite o nome ou email do cliente..." />
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Filtrar</button>
                <a asp-page="./Index" class="btn btn-outline-secondary flex-fill">Limpar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabela de Clientes -->
<div class="card border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <a asp-page="./Index" asp-route-ordenacao="@Model.OrdenacaoNome" 
                               class="text-decoration-none text-white">
                                Nome <span class="small">↕️</span>
                            </a>
                        </th>
                        <th>
                            <a asp-page="./Index" asp-route-ordenacao="@Model.OrdenacaoCorrente"
                               asp-route-filtroCorrente="@Model.FiltroCorrente" 
                               class="text-decoration-none text-white">
                                Email <span class="small">↕️</span>
                            </a>
                        </th>
                        <th>Telefone</th>
                        <th>Data Registo</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Clientes.Any())
                    {
                        @foreach (var item in Model.Clientes)
                        {
                            <tr>
                                <td class="fw-bold">@Html.DisplayFor(modelItem => item.Nome) @Html.DisplayFor(modelItem => item.Apelido)</td>
                                <td>@Html.DisplayFor(modelItem => item.Email)</td>
                                <td>@Html.DisplayFor(modelItem => item.Telefone)</td>
                                <td>@Html.DisplayFor(modelItem => item.DataRegisto)</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a asp-page="./Details" asp-route-id="@item.ClienteID" 
                                           class="btn btn-info btn-sm" title="Ver Detalhes">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-page="./Edit" asp-route-id="@item.ClienteID" 
                                           class="btn btn-dark btn-sm" title="Editar">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <a asp-page="./Delete" asp-route-id="@item.ClienteID" 
                                           class="btn btn-danger btn-sm" title="Eliminar">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <div class="text-muted">
                                    <p class="mb-2" style="font-size: 2rem;">📭</p>
                                    <p>Nenhum cliente encontrado.</p>
                                    <a asp-page="Create" class="btn btn-primary btn-sm mt-2">Criar Primeiro Cliente</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Paginação -->
<nav class="mt-4">
    <ul class="pagination justify-content-center">
        <!-- Botão Anterior -->
        <li class="page-item @(Model.Clientes.HaPaginasAntes ? "" : "disabled")">
            <a asp-page="./Index"
               asp-route-ordenacao="@Model.OrdenacaoCorrente"
               asp-route-indexPagina="@(Model.Clientes.PaginaIndex - 1)"
               asp-route-filtroCorrente="@Model.FiltroCorrente"
               class="page-link">
                ← Anterior
            </a>
        </li>

        <!-- Número da Página -->
        <li class="page-item active">
            <span class="page-link">
                Página @Model.Clientes.PaginaIndex de @Model.Clientes.TotalPaginas
            </span>
        </li>

        <!-- Botão Próximo -->
        <li class="page-item @(Model.Clientes.HaPaginasDepois ? "" : "disabled")">
            <a asp-page="./Index"
               asp-route-ordenacao="@Model.OrdenacaoCorrente"
               asp-route-indexPagina="@(Model.Clientes.PaginaIndex + 1)"
               asp-route-filtroCorrente="@Model.FiltroCorrente"
               class="page-link">
                Próximo →
            </a>
        </li>
    </ul>
</nav>
