@page
@model PetShop.Pages.Admin.AccessDeniedModel
@{
    ViewData["Title"] = "Acesso Negado";
}

<div class="access-denied-container">
    <div class="access-denied-card text-center">
        <div class="access-denied-icon">🚫</div>
        <h2>Acesso Negado</h2>
        <p class="text-muted mb-4">Não tem permissões para aceder a esta página.</p>
        
        <div class="d-flex gap-3 justify-content-center">
            <a href="/Admin/Login" class="btn btn-primary">
                <i class="fas fa-sign-in-alt"></i> Iniciar Sessão
            </a>
            <a href="/Portal" class="btn btn-secondary">
                <i class="fas fa-home"></i> Ir para o Portal
            </a>
        </div>
    </div>
</div>
