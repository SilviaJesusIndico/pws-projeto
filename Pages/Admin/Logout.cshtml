@page
@model PetShop.Pages.Admin.LogoutModel
@{
    ViewData["Title"] = "Sessão Terminada";
}

<div class="logout-container">
    <div class="logout-card text-center">
        <div class="logout-icon">👋</div>
        <h2>Sessão Terminada</h2>
        <p class="text-muted mb-4">A sua sessão foi terminada com sucesso.</p>
        
        <div class="d-flex gap-3 justify-content-center">
            <a href="/Admin/Login" class="btn btn-primary">
                <i class="fas fa-sign-in-alt"></i> Entrar Novamente
            </a>
            <a href="/Portal" class="btn btn-secondary">
                <i class="fas fa-home"></i> Ir para o Portal
            </a>
        </div>
    </div>
</div>
