@* ============================================================================
    _LAYOUT.CSHTML - Layout Principal do Portal Público
    ============================================================================
    
    Este é o layout base para todas as páginas públicas do portal.
    Define a estrutura HTML comum: header, navbar, conteúdo principal e footer.
    
    Utilização:
    - Páginas do Portal (Index, Servicos, Marcar)
    - Página de Login do Admin
    - Páginas de erro
    
    Estrutura:
    1. HEAD - Meta tags, CSS (Bootstrap, FontAwesome, site.css)
    2. HEADER - Barra de navegação com menu principal e admin
    3. MAIN - Área de conteúdo (@RenderBody)
    4. FOOTER - Rodapé com copyright
    5. SCRIPTS - jQuery, Bootstrap, validação
    
    Funcionalidades:
    - Menu responsivo (collapse em mobile)
    - Menu dropdown de administração (quando autenticado)
    - Destaque visual para botão "Marcar Agora"
============================================================================ *@

<!DOCTYPE html>
<html lang="pt-PT">
<head>
    @* ===== META TAGS ===== *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    @* Título dinâmico: usa ViewData["Title"] de cada página *@
    <title>@ViewData["Title"] - Peludos & Companhia</title>
    
    @* ===== CSS EXTERNO ===== *@
    @* Bootstrap 5 - Framework CSS para layout responsivo *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* FontAwesome 6 - Biblioteca de ícones (fas fa-*) *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    @* Bootstrap Icons - Biblioteca de ícones (bi bi-*) *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @* CSS personalizado da aplicação *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* ===== HEADER COM NAVEGAÇÃO ===== *@
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                @* Logo/Brand - Link para página inicial do portal *@
                <a class="navbar-brand" asp-area="" asp-page="/Portal/Index">
                    <img src="~/images/logopetshop.png" alt="Logo" height="60" class="d-inline-block align-text-top me-2" />
                    <span class="brand-text">Peludos & Companhia</span>
                </a>
                
                @* Botão hamburger para mobile *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    @* ===== MENU PRINCIPAL DO CLIENTE =====
                       Links públicos acessíveis a todos *@
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Portal/Index">
                                <i class="fas fa-home"></i> Início
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Portal/Servicos">
                                <i class="fas fa-paw"></i> Serviços
                            </a>
                        </li>
                        @* Botão destacado para marcar serviço *@
                        <li class="nav-item">
                            <a class="nav-link nav-link-cta" asp-area="" asp-page="/Portal/Marcar">
                                <i class="fas fa-calendar-plus"></i> Marcar Agora
                            </a>
                        </li>
                    </ul>
                    
                    @* ===== MENU DE ADMINISTRAÇÃO =====
                       Mostra opções diferentes conforme estado de autenticação *@
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* UTILIZADOR AUTENTICADO: Mostra dropdown de admin *@
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-admin dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-cog"></i> Admin
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                    @* Secção: Gestão de dados principais *@
                                    <li class="dropdown-header">Gestão</li>
                                    <li><a class="dropdown-item" asp-page="/Agendamentos/Index"><i class="fas fa-calendar-check"></i> Agendamentos</a></li>
                                    <li><a class="dropdown-item" asp-page="/Clientes/Index"><i class="fas fa-users"></i> Clientes</a></li>
                                    <li><a class="dropdown-item" asp-page="/Animais/Index"><i class="fas fa-dog"></i> Animais</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    @* Secção: Configurações do sistema *@
                                    <li class="dropdown-header">Configurações</li>
                                    <li><a class="dropdown-item" asp-page="/Servicos/Index"><i class="fas fa-cut"></i> Serviços</a></li>
                                    <li><a class="dropdown-item" asp-page="/Tecnicos/Index"><i class="fas fa-user-md"></i> Técnicos</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    @* Link de logout *@
                                    <li><a class="dropdown-item text-danger" asp-page="/Admin/Logout"><i class="fas fa-sign-out-alt"></i> Terminar Sessão</a></li>
                                </ul>
                            </li>
                            @* Mostra nome do utilizador autenticado *@
                            <li class="nav-item">
                                <span class="nav-link nav-link-user">
                                    <i class="fas fa-user-circle"></i> @User.Identity?.Name
                                </span>
                            </li>
                        }
                        else
                        {
                            @* UTILIZADOR NÃO AUTENTICADO: Mostra botão de login *@
                            <li class="nav-item">
                                <a class="nav-link nav-link-login" asp-page="/Admin/Login">
                                    <i class="fas fa-sign-in-alt"></i> Admin Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* ===== ÁREA DE CONTEÚDO PRINCIPAL =====
       @RenderBody() insere o conteúdo específico de cada página *@
    <main class="main-content">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    @* ===== RODAPÉ ===== *@
    <footer class="site-footer">
        <div class="container">
            <span>🐾 Peludos & Companhia</span>
            <span>© 2025 Peludos & Companhia Management System</span>
        </div>
    </footer>

    @* ===== SCRIPTS ===== *@
    @* jQuery - Biblioteca JavaScript para manipulação DOM *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @* Bootstrap Bundle - Inclui Popper.js para dropdowns/tooltips *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* JavaScript personalizado da aplicação *@
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Secção opcional para scripts específicos de cada página *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
